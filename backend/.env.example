# MongoDB connection string.
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gean-bebidas?appName=<app>
#   (keep the database name "gean-bebidas" right before the "?", otherwise Mongo uses "test")
# Local (docker compose): mongodb://localhost:27017/gean-bebidas
MONGODB_URI=

# Secret used to sign JWT tokens (use a long random string)
JWT_SECRET=
JWT_EXPIRES_IN=1d

PORT=3000

# Allowed frontend origins for CORS (comma-separated, or * to allow everything in development)
CORS_ORIGIN=http://localhost:5173

# Rate limit for POST /auth/login (optional, defaults: 10 attempts per 60000 ms)
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# Admin account created by `npm run seed` / `npm run seed:admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudflare R2 object storage for product image uploads (optional in dev)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
